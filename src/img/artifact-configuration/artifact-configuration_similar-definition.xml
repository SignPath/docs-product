<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <msi-file>

    <pe-file path="MyApp.exe">
      <authenticode-sign/> 
    </pe-file>

    <directory-set>
      <include path="en" />
      <include path="en-US" />
      <include path="de-DE" />
      <for-each>
        <pe-file-set>
          <include path="MyApp.*.resources.dll" min-matches="0" max-matches="unbounded" />
          <for-each>
            <authenticode-sign/>
          </for-each>
        </pe-file-set>
      </for-each>
    </directory-set>

    <authenticode-sign/>

  </msi-file>
</artifact-configuration>