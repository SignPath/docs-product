{%- comment -%} 
  input parameter: "entries" 
  input parameter: "rss_id"
{%- endcomment -%}
{%- assign id = 'https://docs.signpath.io/status/feeds/' | append: include.rss_id | append: '.xml' -%} 
{%- assign updated = site.data.status.updated -%}
<feed xmlns="http://www.w3.org/2005/Atom">
<generator uri="https://jekyllrb.com/" version="3.9.3">Jekyll</generator>
<link href="{{ id }}" rel="self" type="application/atom+xml"/>
<link href="https://docs.signpath.io/" rel="alternate" type="text/html"/>
<updated>{{ updated | date: '%F' }}</updated>
<id>{{ id }}</id>
<title type="html">SignPath - {{ include.title }}</title>
<author>
  <name>SignPath GmbH</name>
  <uri>https://signpath.io</uri>
</author>
{%- for entry in include.entries -%}
  <entry>
    <id>tag:docs.signpath.io,{{ entry.date | date: '%F'}}:{{ componentid }}:{{ release.version }}</id>
    <title>{{ entry.type | capitalize }}: {{ entry.title }}</title>
    <updated>{{ entry.date | default: updated | date: '%F' }}</updated>
    <published>{{ entry.date | default: updated | date: '%F' }}</published>
    <link rel="alternate" href="https://docs.signpath.io/status#{{ entry.range | slugify }}" />
    <summary type="html"> <![CDATA[
        <h3>{{ entry.range }}</h3>
        {{ entry.description | markdownify }}
      ]]>
    </summary>
  </entry>
{%- endfor -%}
</feed>